# =============================
# FinancIA Chile — Backend ENV
# =============================
NODE_ENV=development
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# ---- Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role
SUPABASE_ANON_KEY=eyJ...anon

# ---- Redis (Upstash o local)
REDIS_URL=redis://localhost:6379

# ---- Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-4-6

# ---- Google AI Studio (embeddings, free)
# https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=AIza...
EMBEDDING_MODEL=text-embedding-004

# ---- Meta — Instagram + WhatsApp
# Meta App Dashboard → App Settings → Basic
META_APP_SECRET=ab12cd34...
# Token que tú elijes; lo usas para verify del webhook GET
META_VERIFY_TOKEN=tu-verify-token-secreto
# Page Access Token (Long-Lived) — debug en https://developers.facebook.com/tools/debug/accesstoken/
META_PAGE_ACCESS_TOKEN=EAAB...
# Instagram Business User ID (Graph API: GET /me/accounts → id)
IG_USER_ID=17841...
# WhatsApp Business — desde el dashboard de Meta
WHATSAPP_PHONE_NUMBER_ID=12345...
WHATSAPP_ACCESS_TOKEN=EAAB...

# ---- CMF (opcional; muchos endpoints son públicos)
CMF_API_KEY=
CMF_BASE_URL=https://api.cmfchile.cl/api-sbifv3/recursos_api

# ---- Internal
INTERNAL_SECRET=cambia-este-string-aleatorio-de-32-chars

# ---- Sentry
SENTRY_DSN=

# ---- Limits
RATE_LIMIT_PER_DAY=20
RATE_LIMIT_PER_HOUR=5
