# =============================
# FinancIA Chile — Backend ENV (PLACEHOLDERS)
# =============================
# IMPORTANTE: este archivo va a git. NO PEGAR SECRETOS REALES AQUÍ.
# Los secretos reales van en .env (git-ignored).
# =============================

NODE_ENV=development
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# ---- Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role
SUPABASE_ANON_KEY=eyJ...anon

# ---- Redis (Upstash o local)
REDIS_URL=redis://localhost:6379

# ---- Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-4-6

# ---- Google AI Studio (embeddings, free)
# https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=AIza...
EMBEDDING_MODEL=text-embedding-004

# ---- Zernio — gestiona Instagram + WhatsApp con 1 sola key (en lugar de 6 vars de Meta)
# https://docs.zernio.com — dashboard te da la API key
ZERNIO_API_KEY=zer_...
# Webhook signing secret (configurado al crear el webhook en dashboard Zernio)
ZERNIO_WEBHOOK_SECRET=whsec_...
ZERNIO_BASE_URL=https://api.zernio.com

# ---- CMF (opcional; muchos endpoints son públicos)
CMF_API_KEY=
CMF_BASE_URL=https://api.cmfchile.cl/api-sbifv3/recursos_api

# ---- Internal (service-to-service)
INTERNAL_SECRET=cambia-este-string-aleatorio-de-32-chars

# ---- Limits
RATE_LIMIT_PER_DAY=20
RATE_LIMIT_PER_HOUR=5
